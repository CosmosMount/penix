{
  "board": "stm32h723",
  "build": { "usbx": true, "motors": { "dji": true, "dm": true, "lk": false } },
  "bindings": { "remoter_uart": "uart5", "referee_uart": "usart1" },
  "can": { "fdcan1": { "id_type": "standard" } },
  "can_diag": { "enabled": true, "sample_period_ms": 1000, "window_size": 60 },
  "ahrs": { "imu_offset_x": 0.0, "imu_thread_priority": 3, "temp_thread_priority": 4, "target_temp": 45.0 },
  "dmimu": { "communication_mode": "active", "offline_timeout_ticks": 100, "thread_priority": 3, "receive_wait_ticks": 1, "request_period_ticks": 1 },
  "remoter": { "source": "dr16", "thread_priority": 2, "rx_timeout_ticks": 100 },
  "referee": { "thread_priority": 8 },
  "test": { "thread_priority": 10, "report_uart": "uart7", "auto_run_on_boot": false },
  "robot": {
    "devices": {
      "dmimu": { "enabled": true, "can_bus": "fdcan3", "can_type": "classic", "can_id": "0x04", "master_id": "0x04" },
      "motors": {
        "dm": { "id_base": "0x01", "master_id_base": "0x05", "max_motors": 4 },
        "list": [
          { "name": "motor1", "model": "dji_gm6020", "can_bus": "fdcan2", "can_type": "classic", "can_id": "0x205" },
          { "name": "motor2", "model": "dm_dm4310", "can_bus": "fdcan1", "can_type": "fd", "can_id": "0x01", "control_mode": "mit" },
          { "name": "motor3", "model": "dji_gm6020", "can_bus": "fdcan1", "can_type": "fd", "can_id": "0x206" }
        ]
      }
    }
  }
}
